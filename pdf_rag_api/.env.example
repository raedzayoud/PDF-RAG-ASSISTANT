# Groq credentials and LLM model. Create a free key at https://console.groq.com/.
GROQ_API_KEY=put_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=openai/gpt-oss-20b

# Local embedding model (downloads once and runs locally).
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Basic RAG tuning options.
DOCUMENTS_DIR=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
HISTORY_MESSAGES=10

# PostgreSQL credentials must match the values in docker-compose.yml.
POSTGRES_DB=rag_memory
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password_change_me
DATABASE_URL=postgresql+psycopg://rag_user:rag_password_change_me@localhost:5433/rag_memory?connect_timeout=10

# Angular's usual development origin. Add your real frontend origin when deployed.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
